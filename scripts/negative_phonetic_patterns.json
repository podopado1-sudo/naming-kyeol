    "negative_combinations": [
      {
        "pattern": "추*",
        "description": "추로 시작하는 음절은 '추하다'와 연상되어 부정적",
        "penalty": 15
      },
      {
        "pattern": "허*",
        "description": "허로 시작하는 음절은 '허하다', '허탈하다'와 연상",
