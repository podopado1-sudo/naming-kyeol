    "morpheme_patterns": {
      "description": "형태소 겹침으로 인한 부정적 의미 패턴",
      "patterns": [
        {
          "pattern": "허*해*",
          "description": "허+해 조합은 '허해지다'와 연상",
          "penalty": 30,
          "examples": ["허해진", "허해지", "허해"]
        },
        {
          "pattern": "*추*광",
          "description": "추+광 조합은 '추하다'와 연상",
          "penalty": 25,
          "examples": ["추광", "허추광"]
        },
        {
          "pattern": "허*추*",
          "description": "허+추 조합은 부정적 어감",
          "penalty": 30,
          "examples": ["허추광", "허추"]
        },
        {
          "pattern": "*망*",
          "description": "이름 안 망 글자는 망조와 연상",
          "penalty": 20,
          "examples": ["망호", "망지"]
        },
        {
          "pattern": "*죽*",
          "description": "이름 안 죽 글자는 죽음과 직결",
          "penalty": 35,
          "examples": ["죽현", "은죽"]
        },
        {
          "pattern": "*악*",
          "description": "이름 안 악 글자는 악과 연상",
          "penalty": 20,
          "examples": ["악현", "윤악"]
        },
        {
          "pattern": "*흉*",
          "description": "이름 안 흉 글자는 흉과 직결",
