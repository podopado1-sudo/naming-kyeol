## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Secrets / 운영용 설정 (절대 커밋 금지)
appsettings.Production.json
appsettings.*.local.json
secrets.json
*.env
.env
.env.local
.env.production
.env.production.local
**/wwwroot/secrets/


# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/

# Visual Studio cache/options directory
.vs/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NuGet Packages
*.nupkg
**/packages/*

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# Rider
.idea/
*.sln.iml

# VS Code
.vscode/

# Mac
.DS_Store

# Claude Code 캐시·세션 (개인 정보)
.claude/

# 로컬 SQLite DB (사용자 데이터 잠재) — 운영은 PostgreSQL
*.db
*.db-shm
*.db-wal

# 로그 파일 (Serilog 자동 생성)
logs/
*.log

# 임시/스크래치 파일
tmp/
*.tmp

# 디자인 자산 zip (별도 관리)
NameForm_design.zip
NameForm_design/

# 마스코트 작업 산출물 — favicon.io ZIP과 추출 폴더 (이미 public/ 루트로 복사됨)
frontend/public/mascot/favicon_io*
frontend/public/mascot/*.zip

# Node modules (frontend)
node_modules/

# Next.js 빌드 산출물
.next/
out/
frontend/.next/
frontend/out/

# Test 결과
TestResults/
coverage/
*.trx

# 실명 통계 원천 CSV (대법원 기반, 재배포 회피 — build_name_gender_data.py가 사용)
scripts/_name_raw/

# 감사 스크립트 임시 출력
scripts/_audit_report.txt
